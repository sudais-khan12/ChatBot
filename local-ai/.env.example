# Open WebUI local deployment settings.
# Copy to local-ai/.env and adjust if needed. No secrets belong in this file:
# the session signing key is generated automatically inside the data directory.

# --- Where the interface listens -----------------------------------------
# 127.0.0.1 keeps the UI off the LAN. Port 3000 is already used by a local
# Node/Next.js dev server on this machine, so 8080 is the default here.
WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=8080

# --- Where persistent data lives ------------------------------------------
# SQLite database, uploads, vector store and cached models. Must stay on D:.
OPEN_WEBUI_DATA_DIR=D:/olama/open-webui

# --- How the interface reaches Ollama -------------------------------------
# The UI runs in its own container, so localhost would point at that container.
# host.docker.internal is the Windows host, where the "Olama" container
# publishes port 11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Image version ---------------------------------------------------------
# Pinned so an unexpected upgrade cannot change behaviour. Bump deliberately.
WEBUI_DOCKER_TAG=v0.12.4
WEBUI_CONTAINER_NAME=ai-chat-ui

# --- Realtime connection ------------------------------------------------
# Semicolon-separated. localhost and 127.0.0.1 are DIFFERENT origins to the
# websocket server; both must be listed or the UI reports "Connection lost".
CORS_ALLOW_ORIGIN=http://localhost:8080;http://127.0.0.1:8080;http://[::1]:8080

# --- Startup warm-up ------------------------------------------------------
# Model loaded in the background by the launcher so the first reply is fast.
# Blank disables it.
PRELOAD_MODEL=qwen2.5:3b
